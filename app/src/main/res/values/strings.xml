    <string name="perm_audio">Music bars</string>
    <string name="perm_audio_desc">Lets the circle of the collapsed player move with the music. Android calls this “microphone”, but Dockside only measures the loudness of what is playing and never records anything.</string>
    <string name="w_weather_hourly">Hourly forecast</string>
    <string name="ignore_posture">Start in any position</string>
    <string name="ignore_posture_desc">For phones whose motion sensor doesn’t work: start whenever the phone is charging and locked, without checking that it lies on its side. Dockside always shows in landscape.</string>
    <string name="burn_in">Burn-in protection</string>
    <string name="burn_in_desc">Clock faces drift slowly around the screen and everything else shifts by a few pixels, so no picture stays in one place for hours</string>
    <string name="section_motion">Animations</string>
    <string name="motion_all">Super animations</string>
